{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE subscription\n            SET modification_date_time = now(),\n                client_name = $2,\n                program_id = $3,\n                object_operations = $4,\n                subscriber_scopes = COALESCE($6, subscriber_scopes)\n            WHERE id = $1\n              AND ($5::text IS NULL OR client_id = $5)\n            RETURNING\n                id,\n                created_date_time,\n                modification_date_time,\n                client_id,\n                client_name,\n                program_id,\n                object_operations\n            ",
